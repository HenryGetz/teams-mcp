# teams-mcp environment overrides (copy to .env for local use; never commit).
# Environment variables take precedence over config.yaml.

# Where token.json, profile/ and config.yaml live.
TEAMS_MCP_CONFIG_DIR=/home/you/.config/teams-mcp
# Alternative path to the YAML file itself.
# TEAMS_MCP_CONFIG_FILE=/home/you/.config/teams-mcp/config.yaml

# Default timezone (overrides config.yaml timezone).
TEAMS_MCP_TIMEZONE=America/Chicago

# Primary API: Outlook REST v2.0 (mail, calendar, scheduling).
TEAMS_MCP_OUTLOOK_BASE_URL=https://outlook.office.com/api/v2.0

# Graph is used for directory search only (mail/calendar Graph access is 403 here).
TEAMS_MCP_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Persistent Chromium profile used by the login/refresh flow.
# TEAMS_MCP_PROFILE_DIR=/home/you/.config/teams-mcp/browser-profile

# Network tuning.
TEAMS_MCP_REQUEST_TIMEOUT_MS=30000
TEAMS_MCP_MAX_ATTEMPTS=4

# Cache locations and TTLs.
# TEAMS_MCP_CACHE_DIR=/home/you/.cache/teams-mcp
# TEAMS_MCP_SNAPSHOT_DIR=/home/you/.cache/teams-mcp/snapshots
# TEAMS_MCP_OWN_CALENDAR_TTL_MINUTES=5
# TEAMS_MCP_BUSY_TTL_MINUTES=30
# TEAMS_MCP_DIRECTORY_TTL_MINUTES=60
# TEAMS_MCP_DEFAULT_DURATION_MIN=30

# Credentials for CI / one-shot logins only (read by src/auth/login.ts).
# Prefer ~/.config/teams-mcp/credentials.json (0600); these env vars win over it.
# TEAMS_MCP_USERNAME=user@example.com
# TEAMS_MCP_PASSWORD=
# TEAMS_MCP_TOTP_SECRET=

# Safety / capability scoping. Defaults are safe for a live account:
#  - read_only=1 refuses every write before any request (reads still work).
#    Recommended for autonomous agents and evals.
#  - unsubscribe is off by default; one-click unsubscribe is irreversible.
#  - write rate limit covers mail mark/move and unsubscribe_apply.
# TEAMS_MCP_READ_ONLY=0
# TEAMS_MCP_UNSUBSCRIBE_ENABLED=0
# TEAMS_MCP_UNSUBSCRIBE_DAILY_CAP=5
# TEAMS_MCP_WRITE_RATE_LIMIT_PER_MINUTE=30
# Operator-only Teams send allowlist, comma-separated: chat:<chat_id> or
# channel:<team_id>/<channel_id>. Server-created targets never need an entry.
# TEAMS_MCP_TEAMS_ALLOWED_TARGETS=chat:19:abc@thread.v2,channel:<team-id>/19:ch@thread.tacv2

# No secrets belong in this file: credentials live only in
# ~/.config/teams-mcp/token.json (0600), written by the login flow, or in the
# CI-only variables above.
